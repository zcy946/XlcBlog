---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPosts, formatDate, readingMinutes } from '../../lib/posts';
import '../../styles/briefing.css';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({ params: { slug: post.id }, props: { post, next: posts[(index + 1) % posts.length], hasNext: posts.length > 1 } }));
}
const { post, next, hasNext } = Astro.props;
const { Content, headings } = await render(post);
const isBriefing = post.data.format === 'briefing';
---
<BaseLayout title={post.data.title} description={post.data.description} article>
  <article class:list={['article-page', { 'briefing-page': isBriefing }]}>
    <header class="article-header"><a class="back-link" href="/writing/">← 全部文章</a><div class="post-meta"><span>{post.data.category}</span><span>·</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>·</span><span>{readingMinutes(post.body)} 分钟阅读</span></div><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p>{post.data.sample && <p class="sample-notice">示例文章 · 用于展示排版和阅读体验</p>}</header>
    <div class="article-body-grid"><div class="prose" data-article-content><Content /></div><TableOfContents headings={headings} /></div>
    <footer class="article-footer"><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div><p>谢谢你读到这里。</p>{hasNext && <a class="next-article" href={`/writing/${next.id}/`}><span>接着读一篇 →</span><strong>{next.data.title}</strong></a>}</footer>
  </article>
</BaseLayout>
