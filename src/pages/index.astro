---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import Arrow from '../components/Arrow.astro';
import { profile, projects } from '../data/site';
import { getPosts } from '../lib/posts';
const posts = (await getPosts()).slice(0, 3);
---
<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> A SMALL CORNER OF THE INTERNET</p>
      <h1 id="hero-title">记录思考，<br />构建<span class="hero-accent">有趣的想法</span>。</h1>
      <p class="hero-intro">{profile.introduction}</p>
      <div class="hero-links"><a class="button-link" href="/writing/">读一读文章 <Arrow /></a><a class="text-link" href="/about/">更多关于我 <Arrow diagonal /></a></div>
    </div>
    <div class="hero-aside" aria-hidden="true">
      <div class="field-note">
        <div class="field-note-top"><span>FIELD NOTES</span><span>No. 001</span></div>
        <svg class="plant" viewBox="0 0 240 240" fill="none">
          <ellipse cx="121" cy="211" rx="57" ry="5" fill="currentColor" opacity=".07" />
          <path d="M116 191c-6-42 18-66 9-118m-5 90c-19-9-39-25-48-49m53 21c24-12 39-29 47-48" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path d="M125 88c-29-12-42-31-31-56 27 13 36 32 31 56Z" fill="currentColor" opacity=".7" />
          <path d="M126 124c-2-38 17-61 49-58-1 31-18 49-49 58Z" fill="currentColor" opacity=".9" />
          <path d="M100 153c-33-4-55-23-51-51 32 1 51 22 51 51Z" fill="currentColor" opacity=".55" />
          <path d="M118 184c9-32 31-47 60-34-10 26-29 36-60 34Z" fill="currentColor" opacity=".75" />
          <path d="M93 188h51l-8 25h-35l-8-25Z" fill="currentColor" opacity=".15" /><path d="M93 188h51" stroke="currentColor" stroke-width="2"/>
        </svg>
        <p>给想法一点时间。</p><span class="field-note-bottom">ROOM TO THINK. SPACE TO GROW.</span>
      </div>
      <span class="aside-caption">日有所思，也有所作。 <span>↙</span></span>
    </div>
  </section>
  <div class="intro-strip"><p><span>在这里</span> 写一点文字，做一些小东西，记录沿途的发现。</p><span class="strip-mark" aria-hidden="true">✳</span></div>
  <section class="home-section" aria-labelledby="projects-heading">
    <div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2 id="projects-heading">把想法做出来<span>.</span></h2></div><a class="text-link" href="/projects/">全部项目 <Arrow /></a></div>
    <div class="project-grid">{projects.slice(0, 2).map(project => <ProjectCard project={project} />)}</div>
  </section>
  <section class="home-section writing-section" aria-labelledby="writing-heading">
    <div class="section-heading"><div><p class="eyebrow">RECENT WRITING</p><h2 id="writing-heading">最近写下的<span>.</span></h2></div><a class="text-link" href="/writing/">全部文章 <Arrow /></a></div>
    <div class="post-list">{posts.map(post => <PostRow post={post} />)}</div>
    {profile.sample && <p class="demo-note">这里的个人介绍与标注为“示例”的内容用于展示，可在准备好后替换。</p>}
  </section>
  <div class="closing-note"><span aria-hidden="true">✳</span><p>不急着抵达，<br />也享受慢慢构建的过程。</p><a class="text-link" href="/about/">认识一下 <Arrow diagonal /></a></div>
</BaseLayout>
