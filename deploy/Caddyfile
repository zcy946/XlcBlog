# 替换域名，将 dist/ 内的内容部署到 /var/www/xlc-blog。
blog.example.com {
  root * /var/www/xlc-blog
  encode zstd gzip
  file_server

  @assets path /_astro/*
  header @assets Cache-Control "public, max-age=31536000, immutable"

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }

  handle_errors {
    @notFound expression {err.status_code} == 404
    handle @notFound {
      rewrite * /404.html
      file_server
    }
  }
}
